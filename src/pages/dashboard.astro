---
const logo =
  "https://stainandsealsupply.com/cdn/shop/files/21714a12dba0614c5d929953e4a1c857_180x@2x.png?v=1744904094";

const kpis = [
  {
    label: "Total Revenue",
    value: "$482,940",
    change: "+12.4%",
    note: "vs last 30 days",
  },
  {
    label: "B2B Revenue",
    value: "$311,280",
    change: "+8.9%",
    note: "64.5% of total sales",
  },
  {
    label: "Orders",
    value: "2,184",
    change: "+5.1%",
    note: "avg order value $221",
  },
  {
    label: "Returning Customer Rate",
    value: "41.8%",
    change: "+3.2%",
    note: "new customers still growing",
  },
];

const monthlyRevenue = [68, 74, 72, 81, 95, 88, 104, 112, 108, 121, 129, 142];
const revenueMonths = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
const maxRevenue = Math.max(...monthlyRevenue);

const channelSales = [
  { label: "B2B", value: 64.5 },
  { label: "Retail", value: 35.5 },
];

const discountSales = [
  { label: "0%", value: 38 },
  { label: "10%", value: 27 },
  { label: "15 - 20%%", value: 19 },
  { label: "25%", value: 10 },
  { label: "30%+", value: 6 },
];

const regionSales = [
  { label: "Midwest", value: 31 },
  { label: "South", value: 24 },
  { label: "West", value: 21 },
  { label: "Northeast", value: 15 },
  { label: "Canada", value: 9 },
];

const customerMix = [
  { label: "New", value: 58.2 },
  { label: "Returning", value: 41.8 },
];

const ops = [
  { label: "Open Orders", value: "146", status: "Normal" },
  { label: "Low Inventory SKUs", value: "18", status: "Needs attention" },
  { label: "Avg Fulfillment Time", value: "1.8 days", status: "Healthy" },
  { label: "Support Tickets", value: "23", status: "Stable" },
];

const topProducts = [
  { name: "Professional Stain Brushes", revenue: "$96,200", units: "1,245", share: 82 },
  { name: "Deck & Fence Applicators", revenue: "$74,480", units: "2,012", share: 64 },
  { name: "Spray Poles & Accessories", revenue: "$58,930", units: "496", share: 51 },
  { name: "Wood Cleaner / Prep", revenue: "$43,610", units: "1,118", share: 38 },
  { name: "Stain & Seal Kits", revenue: "$36,420", units: "327", share: 31 },
];

const recentActivity = [
  "New wholesale account created in Colorado",
  "Region sales spike in Midwest this week",
  "Discount usage above target for 21 to 30% tier",
  "Three SKUs flagged for low stock",
  "Returning customer revenue hit monthly high",
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Business Operations Dashboard</title>
    <style>
      :root {
        --bg: #0b1020;
        --panel: rgba(16, 23, 42, 0.78);
        --panel-strong: #121a31;
        --panel-soft: #16203d;
        --border: rgba(255, 255, 255, 0.08);
        --text: #eef2ff;
        --muted: #9aa6c5;
        --accent: #5b8cff;
        --accent-soft: rgba(91, 140, 255, 0.16);
        --green: #31c48d;
        --yellow: #f5b942;
        --red: #f97066;
        --shadow: 0 24px 70px rgba(0, 0, 0, 0.32);
        --radius: 22px;
        --radius-sm: 16px;
        --grid-gap: 22px;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        background:
          radial-gradient(circle at top left, rgba(91, 140, 255, 0.18), transparent 26%),
          radial-gradient(circle at top right, rgba(76, 201, 240, 0.12), transparent 24%),
          linear-gradient(180deg, #08101f 0%, #0b1020 100%);
        color: var(--text);
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .shell {
        max-width: 1480px;
        margin: 0 auto;
        padding: 28px;
      }

      .topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 28px;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 14px;
      }

      .brand img {
        width: 52px;
        height: 52px;
        object-fit: contain;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.06);
        padding: 6px;
      }

      .brand-copy h1 {
        margin: 0;
        font-size: 1.15rem;
        line-height: 1.1;
        letter-spacing: 0.01em;
      }

      .brand-copy p {
        margin: 4px 0 0;
        color: var(--muted);
        font-size: 0.92rem;
      }

      .toolbar {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
      }

      .chip {
        border: 1px solid var(--border);
        background: rgba(255, 255, 255, 0.04);
        color: var(--text);
        padding: 10px 14px;
        border-radius: 999px;
        font-size: 0.9rem;
        line-height: 1;
      }

      .chip--active {
        background: linear-gradient(180deg, rgba(91, 140, 255, 0.22), rgba(91, 140, 255, 0.14));
        border-color: rgba(91, 140, 255, 0.42);
      }

      .kpi-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: var(--grid-gap);
        margin-bottom: 24px;
      }

      .panel {
        background: linear-gradient(180deg, rgba(18, 26, 49, 0.94), rgba(13, 19, 36, 0.94));
        border: 1px solid var(--border);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        overflow: hidden;
      }

      .panel-inner {
        padding: 22px;
      }

      .kpi-card {
        position: relative;
      }

      .kpi-card::after {
        content: "";
        position: absolute;
        inset: auto 18px 0 auto;
        width: 110px;
        height: 110px;
        background: radial-gradient(circle, rgba(91, 140, 255, 0.16), transparent 68%);
        pointer-events: none;
      }

      .eyebrow {
        color: var(--muted);
        font-size: 0.86rem;
        margin-bottom: 14px;
      }

      .kpi-value {
        font-size: 2rem;
        font-weight: 700;
        letter-spacing: -0.03em;
        margin: 0 0 8px;
      }

      .delta {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 0.9rem;
        color: var(--green);
        margin-bottom: 8px;
      }

      .delta::before {
        content: "↗";
        display: inline-block;
      }

      .subtle {
        color: var(--muted);
        font-size: 0.92rem;
      }

      .layout {
        display: grid;
        grid-template-columns: 2fr 1.1fr;
        gap: 24px;
      }

      .stack {
        display: grid;
        gap: 24px;
      }

      .panel-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 14px;
        margin-bottom: 20px;
      }

      .panel-title {
        margin: 0;
        font-size: 1.08rem;
        font-weight: 700;
      }

      .panel-note {
        color: var(--muted);
        font-size: 0.88rem;
      }

      .chart-wrap {
        width: 100%;
        overflow: hidden;
      }

      .line-chart {
        width: 100%;
        height: auto;
        display: block;
      }

      .legend {
        display: flex;
        gap: 14px;
        flex-wrap: wrap;
        margin-top: 18px;
      }

      .legend-item {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--muted);
        font-size: 0.88rem;
      }

      .legend-swatch {
        width: 10px;
        height: 10px;
        border-radius: 999px;
        background: var(--accent);
      }

      .two-col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
      }

      .bars {
        display: grid;
        gap: 14px;
      }

      .bar-row {
        display: grid;
        gap: 8px;
      }

      .bar-meta {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        font-size: 0.92rem;
      }

      .bar-label {
        color: var(--text);
      }

      .bar-value {
        color: var(--muted);
      }

      .bar-track {
        width: 100%;
        height: 12px;
        background: rgba(255, 255, 255, 0.06);
        border-radius: 999px;
        overflow: hidden;
      }

      .bar-fill {
        height: 100%;
        border-radius: 999px;
        background: linear-gradient(90deg, rgba(91, 140, 255, 0.7), rgba(91, 140, 255, 1));
      }

      .donut-wrap {
        display: grid;
        grid-template-columns: 190px 1fr;
        align-items: center;
        gap: 20px;
      }

      .donut {
        width: 190px;
        height: 190px;
        border-radius: 50%;
        position: relative;
        display: grid;
        place-items: center;
        background:
          conic-gradient(var(--accent) 0 64.5%, rgba(255, 255, 255, 0.08) 64.5% 100%);
      }

      .donut.two {
        background:
          conic-gradient(var(--accent) 0 58.2%, rgba(255, 255, 255, 0.08) 58.2% 100%);
      }

      .donut::after {
        content: "";
        position: absolute;
        inset: 22px;
        border-radius: 50%;
        background: var(--panel-strong);
        border: 1px solid rgba(255, 255, 255, 0.04);
      }

      .donut-center {
        position: relative;
        z-index: 1;
        text-align: center;
      }

      .donut-center strong {
        display: block;
        font-size: 1.75rem;
        letter-spacing: -0.04em;
      }

      .donut-center span {
        color: var(--muted);
        font-size: 0.88rem;
      }

      .split-legend {
        display: grid;
        gap: 14px;
      }

      .split-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        border: 1px solid var(--border);
        background: rgba(255, 255, 255, 0.03);
        border-radius: 14px;
        padding: 14px 16px;
      }

      .split-left {
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .split-dot {
        width: 11px;
        height: 11px;
        border-radius: 50%;
        background: var(--accent);
      }

      .split-dot.muted {
        background: rgba(255, 255, 255, 0.28);
      }

      .split-name {
        font-size: 0.95rem;
      }

      .split-val {
        color: var(--muted);
        font-size: 0.92rem;
      }

      .ops-grid {
        display: grid;
        gap: 14px;
      }

      .ops-card {
        border: 1px solid var(--border);
        background: rgba(255, 255, 255, 0.03);
        border-radius: 16px;
        padding: 16px;
      }

      .ops-top {
        display: flex;
        justify-content: space-between;
        gap: 14px;
        margin-bottom: 8px;
      }

      .ops-label {
        color: var(--muted);
        font-size: 0.88rem;
      }

      .ops-value {
        font-size: 1.35rem;
        font-weight: 700;
        letter-spacing: -0.03em;
      }

      .status {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 0.84rem;
        color: var(--muted);
      }

      .status::before {
        content: "";
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background: var(--green);
      }

      .status.warn::before {
        background: var(--yellow);
      }

      .products {
        display: grid;
        gap: 14px;
      }

      .product-row {
        display: grid;
        gap: 10px;
      }

      .product-top {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        align-items: flex-start;
      }

      .product-name {
        font-weight: 600;
      }

      .product-sub {
        color: var(--muted);
        font-size: 0.88rem;
        margin-top: 4px;
      }

      .activity-list {
        display: grid;
        gap: 12px;
      }

      .activity-item {
        display: flex;
        gap: 12px;
        align-items: flex-start;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        padding-bottom: 12px;
      }

      .activity-item:last-child {
        border-bottom: 0;
        padding-bottom: 0;
      }

      .activity-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: var(--accent);
        margin-top: 6px;
        flex: 0 0 auto;
      }

      .muted {
        color: var(--muted);
      }

      @media (max-width: 1180px) {
        .kpi-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .layout,
        .two-col {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 760px) {
        .shell {
          padding: 18px;
        }

        .topbar {
          flex-direction: column;
          align-items: flex-start;
        }

        .kpi-grid {
          grid-template-columns: 1fr;
        }

        .donut-wrap {
          grid-template-columns: 1fr;
          justify-items: center;
        }

        .panel-inner {
          padding: 18px;
        }

        .brand-copy h1 {
          font-size: 1rem;
        }
      }
    </style>
  </head>

  <body>
    <main class="shell">
      <header class="topbar">
        <div class="brand">
          <img src={logo} alt="Company logo" />
          <div class="brand-copy">
            <h1>Business Status Dashboard</h1>
            <p>Sales, customers, operations, and regional performance</p>
          </div>
        </div>

        <div class="toolbar">
          <span class="chip chip--active">Last 30 Days</span>
          <span class="chip">Wholesale Focus</span>
          <span class="chip">Operations</span>
          <span class="chip">Revenue Trends</span>
        </div>
      </header>

      <section class="kpi-grid">
        {kpis.map((item) => (
          <article class="panel kpi-card">
            <div class="panel-inner">
              <div class="eyebrow">{item.label}</div>
              <h2 class="kpi-value">{item.value}</h2>
              <div class="delta">{item.change}</div>
              <div class="subtle">{item.note}</div>
            </div>
          </article>
        ))}
      </section>

      <section class="layout">
        <div class="stack">
          <article class="panel">
            <div class="panel-inner">
              <div class="panel-head">
                <div>
                  <h3 class="panel-title">Monthly Revenue Trend</h3>
                  <div class="panel-note">Indexed trend view across the current year</div>
                </div>
                <span class="chip">Revenue</span>
              </div>

              <div class="chart-wrap">
                <svg class="line-chart" viewBox="0 0 900 320" role="img" aria-label="Monthly revenue trend chart">
                  <defs>
                    <linearGradient id="lineFill" x1="0" x2="0" y1="0" y2="1">
                      <stop offset="0%" stop-color="rgba(91,140,255,0.38)" />
                      <stop offset="100%" stop-color="rgba(91,140,255,0)" />
                    </linearGradient>
                  </defs>

                  <g>
                    {[0, 1, 2, 3, 4].map((i) => (
                      <line
                        x1="60"
                        y1={40 + i * 55}
                        x2="860"
                        y2={40 + i * 55}
                        stroke="rgba(255,255,255,0.08)"
                        stroke-width="1"
                      />
                    ))}
                  </g>

                  <g>
                    {monthlyRevenue.map((point, i) => {
                      const x = 60 + (i * (800 / (monthlyRevenue.length - 1)));
                      const y = 260 - ((point / maxRevenue) * 190);

                      return (
                        <>
                          <text
                            x={x}
                            y="295"
                            text-anchor="middle"
                            font-size="12"
                            fill="rgba(154,166,197,0.9)"
                          >
                            {revenueMonths[i]}
                          </text>
                          <circle cx={x} cy={y} r="5" fill="#5b8cff" />
                        </>
                      );
                    })}
                  </g>

                  <path
                    d={`M ${monthlyRevenue
                      .map((point, i) => {
                        const x = 60 + (i * (800 / (monthlyRevenue.length - 1)));
                        const y = 260 - ((point / maxRevenue) * 190);
                        return `${i === 0 ? "M" : "L"} ${x} ${y}`;
                      })
                      .join(" ")}`}
                    fill="none"
                    stroke="#5b8cff"
                    stroke-width="4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />

                  <path
                    d={`M 60 260 ${monthlyRevenue
                      .map((point, i) => {
                        const x = 60 + (i * (800 / (monthlyRevenue.length - 1)));
                        const y = 260 - ((point / maxRevenue) * 190);
                        return `L ${x} ${y}`;
                      })
                      .join(" ")} L 860 260 Z`}
                    fill="url(#lineFill)"
                    opacity="1"
                  />
                </svg>
              </div>

              <div class="legend">
                <div class="legend-item">
                  <span class="legend-swatch"></span>
                  <span>Revenue growth trend</span>
                </div>
              </div>
            </div>
          </article>

          <div class="two-col">
            <article class="panel">
              <div class="panel-inner">
                <div class="panel-head">
                  <div>
                    <h3 class="panel-title">Sales by Discount Tier</h3>
                    <div class="panel-note">How revenue distributes across applied discount ranges</div>
                  </div>
                </div>

                <div class="bars">
                  {discountSales.map((item) => (
                    <div class="bar-row">
                      <div class="bar-meta">
                        <span class="bar-label">{item.label}</span>
                        <span class="bar-value">{item.value}%</span>
                      </div>
                      <div class="bar-track">
                        <div class="bar-fill" style={`width:${item.value}%`}></div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </article>

            <article class="panel">
              <div class="panel-inner">
                <div class="panel-head">
                  <div>
                    <h3 class="panel-title">Sales by Region</h3>
                    <div class="panel-note">Regional share of total revenue</div>
                  </div>
                </div>

                <div class="bars">
                  {regionSales.map((item) => (
                    <div class="bar-row">
                      <div class="bar-meta">
                        <span class="bar-label">{item.label}</span>
                        <span class="bar-value">{item.value}%</span>
                      </div>
                      <div class="bar-track">
                        <div class="bar-fill" style={`width:${item.value}%`}></div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </article>
          </div>

          <article class="panel">
            <div class="panel-inner">
              <div class="panel-head">
                <div>
                  <h3 class="panel-title">Top Product Performance</h3>
                  <div class="panel-note">Revenue and unit volume by category</div>
                </div>
                <span class="chip">Products</span>
              </div>

              <div class="products">
                {topProducts.map((product) => (
                  <div class="product-row">
                    <div class="product-top">
                      <div>
                        <div class="product-name">{product.name}</div>
                        <div class="product-sub">{product.units} units sold</div>
                      </div>
                      <div class="product-name">{product.revenue}</div>
                    </div>
                    <div class="bar-track">
                      <div class="bar-fill" style={`width:${product.share}%`}></div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </article>
        </div>

        <div class="stack">
          <article class="panel">
            <div class="panel-inner">
              <div class="panel-head">
                <div>
                  <h3 class="panel-title">Sales Mix by Channel</h3>
                  <div class="panel-note">B2B vs retail contribution</div>
                </div>
              </div>

              <div class="donut-wrap">
                <div class="donut">
                  <div class="donut-center">
                    <strong>64.5%</strong>
                    <span>B2B Share</span>
                  </div>
                </div>

                <div class="split-legend">
                  {channelSales.map((item, i) => (
                    <div class="split-item">
                      <div class="split-left">
                        <span class={`split-dot ${i === 1 ? "muted" : ""}`}></span>
                        <span class="split-name">{item.label}</span>
                      </div>
                      <span class="split-val">{item.value}%</span>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </article>

          <article class="panel">
            <div class="panel-inner">
              <div class="panel-head">
                <div>
                  <h3 class="panel-title">New vs Returning Customers</h3>
                  <div class="panel-note">Customer acquisition and retention mix</div>
                </div>
              </div>

              <div class="donut-wrap">
                <div class="donut two">
                  <div class="donut-center">
                    <strong>58.2%</strong>
                    <span>New Customers</span>
                  </div>
                </div>

                <div class="split-legend">
                  {customerMix.map((item, i) => (
                    <div class="split-item">
                      <div class="split-left">
                        <span class={`split-dot ${i === 1 ? "muted" : ""}`}></span>
                        <span class="split-name">{item.label}</span>
                      </div>
                      <span class="split-val">{item.value}%</span>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </article>

          <article class="panel">
            <div class="panel-inner">
              <div class="panel-head">
                <div>
                  <h3 class="panel-title">Operations Snapshot</h3>
                  <div class="panel-note">Day-to-day business health</div>
                </div>
              </div>

              <div class="ops-grid">
                {ops.map((item) => (
                  <div class="ops-card">
                    <div class="ops-top">
                      <div class="ops-label">{item.label}</div>
                      <div class="ops-value">{item.value}</div>
                    </div>
                    <div class={`status ${item.status === "Needs attention" ? "warn" : ""}`}>
                      {item.status}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </article>

          <article class="panel">
            <div class="panel-inner">
              <div class="panel-head">
                <div>
                  <h3 class="panel-title">Recent Business Activity</h3>
                  <div class="panel-note">Signals worth watching</div>
                </div>
              </div>

              <div class="activity-list">
                {recentActivity.map((item) => (
                  <div class="activity-item">
                    <span class="activity-dot"></span>
                    <div class="muted">{item}</div>
                  </div>
                ))}
              </div>
            </div>
          </article>
        </div>
      </section>
    </main>
  </body>
</html>